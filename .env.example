# Provider selection: `opencode` (default) or `lmstudio`
AGENT_PROVIDER=opencode

# --- OpenCode Zen (large models) ---
OPENCODE_API_KEY=
OPENCODE_MODEL=big-pickle
# OPENCODE_BASE_URL=https://opencode.ai/zen/v1
# OPENCODE_TIMEOUT=60

# --- LM Studio (local, small models) ---
LMSTUDIO_MODEL=
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LMSTUDIO_API_KEY=
# LMSTUDIO_TIMEOUT=60

# Context compression
# CONTEXT_TOKEN_THRESHOLD=6000
# CONTEXT_TOKEN_FACTOR=2.5
# CONTEXT_KEEP_RECENT=4
# CONTEXT_MAX_SUMMARY_CHARS=2000

# Session log of raw model responses (JSONL). Off when unset.
# AGENT_LOG=/tmp/agent.jsonl
